[flake8]
# Maximum line length
max-line-length = 100

# Errors and warnings to ignore
# E203: Whitespace before ':' (conflicts with Black)
# W503: Line break before binary operator (conflicts with Black)
# E501: Line too long (handled by Black)
extend-ignore = E203,W503,E501

# Maximum complexity
max-complexity = 15

# Files to exclude
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    build,
    dist,
    *.egg-info,
    .pytest_cache,
    .mypy_cache,
    htmlcov,
    .tox

# Per-file ignores
per-file-ignores =
    __init__.py:F401
    tests/*:D100,D101,D102,D103

# Docstring conventions
docstring-convention = google

# Show source code for errors
show-source = True

# Show statistics
count = True
statistics = True
