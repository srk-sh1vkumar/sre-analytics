# SRE Analytics Docker Image
FROM python:3.9-slim

# Set working directory
WORKDIR /app

# Install system dependencies for WeasyPrint and Chromium (for pyppeteer)
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libffi-dev \
    libxml2-dev \
    libxslt-dev \
    libcairo2-dev \
    libgdk-pixbuf-2.0-0 \
    shared-mime-info \
    chromium \
    chromium-driver \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    xdg-utils \
    wget \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY src/ ./src/
COPY config/ ./config/
COPY *.py ./

# Create necessary directories
RUN mkdir -p reports/generated logs

# Set environment variables
ENV PYTHONPATH=/app/src
ENV REPORT_OUTPUT_PATH=/app/reports/generated
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Expose port for potential web interface
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import sys; sys.path.append('src'); from reports.enhanced_sre_report_system import EnhancedSREReportSystem; print('OK')" || exit 1

# Default command
CMD ["python", "generate_sre_report.py"]

# Labels for metadata
LABEL maintainer="SRE Team"
LABEL description="SRE Analytics and Reporting System"
LABEL version="1.0"